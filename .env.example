# Sao chép thành .env.local (chạy local) và khai báo cùng tên biến trên Vercel.
# Để trống = game chạy ở chế độ khách, tiến trình chỉ lưu trên máy.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Đặt true sau khi đã bật Google provider trong Supabase → Authentication → Providers
NEXT_PUBLIC_AUTH_GOOGLE=false
